# Copiá este archivo a .env y completá tus keys: cp .env.example .env
PINECONE_API_KEY=pcsk_...
OPENAI_API_KEY=sk-...
INDEX_NAME=rag-python-docs

# Opcional: namespace donde se guardan los vectores (default: python-docs)
PINECONE_NAMESPACE=python-docs

# Opcional: modelo que genera las respuestas (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
